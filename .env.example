# -----------------------------------------------------------------------------
# Remove placeholders: Supabase dashboard → Project Settings → API
# -----------------------------------------------------------------------------
# VITE_SUPABASE_URL      ← Copy "Project URL" (https://xxxxx.supabase.co)
# VITE_SUPABASE_ANON_KEY ← Copy "anon" "public" key (long, often starts with eyJ)
#                          Do NOT use the service_role key in this app.
# VITE_PUBLIC_SLUG       ← Must match landing_content.slug (seed uses "default")
# -----------------------------------------------------------------------------
# Then: cp .env.example .env  (or edit .env), save, and restart npm run dev
# Verify from terminal: npm run check:supabase  (DNS + REST; no browser extensions)
# Apply schema once API works: supabase/RUN_ALL_MIGRATIONS.sql in SQL Editor
# -----------------------------------------------------------------------------

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

VITE_PUBLIC_SLUG=default

# Static fallback CTAs shown on the public page (admin can override via editor once DB migration runs)
VITE_CTA_PHONE=1 385 515 2421
VITE_CTA_EMAIL=aabonnanzieri@gmail.com
